{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "b978f1ca904d4fbab56266e7804a5d08",
    "m_Title": "",
    "m_Content": "Creating a semi transparent material to see underneath layers easier; gives that rift/veil look",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": 251.33334350585938,
        "y": 331.33331298828127,
        "width": 264.0,
        "height": 174.00003051757813
    },
    "m_Group": {
