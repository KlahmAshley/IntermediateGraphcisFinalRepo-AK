    }
}

{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "c894050c328e4db080c6325296495766",
    "m_Title": "",
    "m_Content": "I use fresnel and emission to make it glow and feel very bright similar to the rifts in DAI, but i also felt like reducing the transparency was needed as it toned the effects down more and allowed me to layer ontop without it being overwhelming",
    "m_TextSize": 1,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -32.0,
        "y": 584.0,
        "width": 424.0,
        "height": 270.66668701171877
