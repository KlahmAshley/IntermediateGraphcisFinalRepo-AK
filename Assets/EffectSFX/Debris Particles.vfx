  m_Name: VFXUI
  m_EditorClassIdentifier: 
  groupInfos:
  - title: Init Position
    position:
      serializedVersion: 2
      x: 637
      y: 444
      width: 401
      height: 516
    contents:
    - model: {fileID: 8926484042661615889}
      id: 0
      isStickyNote: 0
    - model: {fileID: 8926484042661615885}
      id: 0
      isStickyNote: 0
    - model: {fileID: 8926484042661615889}
      id: 3
      isStickyNote: 0
  stickyNoteInfos:
  - title: 
    position:
      serializedVersion: 2
      x: 1499
      y: 170
      width: 321
      height: 183
    contents: Sets the spawn rate. These particles are small and die fairly quickly
      therefore I want them to spawn frequently
    theme: Classic
    textSize: Medium
  - title: 
    position:
      serializedVersion: 2
      x: 1505
      y: 499
      width: 274
      height: 151
    contents: 'Initalizing the particles lifetime, capacity and shape/size. '
    theme: Classic
    textSize: Medium
  - title: 
    position:
      serializedVersion: 2
      x: 554
      y: 715
      width: 314
      height: 150
    contents: These boxes are helping the particles form a sphere by giving it sizes
      and positions
    theme: Classic
    textSize: Medium
  - title: 
    position:
      serializedVersion: 2
      x: 1551
      y: 951
      width: 295
      height: 386
    contents: Updating the particles, this is where the movement of the particles
      is established By using a sphere I wanted to also in this section make sure
      it wasnt totally uniform to the shape so the turblence is very useful at creating
      some visual interest
    theme: Classic
    textSize: Medium
  - title: 
    position:
      serializedVersion: 2
      x: 642
      y: 1615
      width: 385
      height: 360
    contents: 'These are the actual particles, I used a smoke texture from the Viking
      Village in this project for these dust type particles. This section changes
      the appearance of them: colour, shape, size, etc. I wanted these particles
      to be small and dark to look like ash or little bits of debris'
    theme: Classic
    textSize: Medium
  categories: []
  uiBounds:
    serializedVersion: 2
    x: 554
    y: 136
    width: 1292
    height: 1988
